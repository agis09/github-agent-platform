# .env — local secrets and settings (copy to .env; .env is gitignored).
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#   set -a; . ./.env; set +a        # load into the current shell
#
# Nothing reads this file automatically: load it in the shell that runs
# terraform / kubectl / scripts / agentctl. See docs/usage.md 2.1.

# =====================================================================
# Cluster access for kubectl and scripts/*.sh (docs/usage.md 7.1)
#   Same file as kubeconfig_path in infra/platform/terraform.tfvars;
#   terraform's kubeconfig_path does not apply to kubectl.
# =====================================================================
# Sakura Cloud k3s example (keep infra/clusters/sakura-k3s/scripts/tunnel.sh running):
# KUBECONFIG=$HOME/.config/agent-platform/kubeconfig-sakura-k3s.yaml
# Other clusters:
# KUBECONFIG=$HOME/.kube/config

# =====================================================================
# A. Deployment to Kubernetes (terraform reads TF_VAR_<variable>)
#    Non-secret settings go to infra/platform/terraform.tfvars; keep only
#    secrets here.
# =====================================================================

# LLM API key (Secret llm-api-key, injected into the agent Jobs only).
TF_VAR_agent_api_key=

# GitHub App webhook secret (same value as in the App settings)
TF_VAR_webhook_secret=

# Optional
# TF_VAR_registry_password=     # private registry pull password / token
# TF_VAR_search_api_key=        # search_provider = brave / http-json

# Sakura Cloud API key (only for infra/clusters/sakura-k3s)
# SAKURACLOUD_ACCESS_TOKEN=
# SAKURACLOUD_ACCESS_TOKEN_SECRET=

# =====================================================================
# B. Local runs (agentctl on this machine, docs/usage.md §1)
# =====================================================================

# AGENT_PLATFORM_ADAPTER=local          # fake | local | k8s

# --- Agent / LLM: Sakura AI Engine (OpenAI-compatible) + Codex CLI ---
# AGENT_PLATFORM_AGENT_RUNTIME=codex
# AGENT_PLATFORM_AGENT_BASE_URL=https://api.ai.sakura.ad.jp/v1
# AGENT_PLATFORM_AGENT_MODEL=gpt-oss-120b
# LLM_API_KEY=<UUID>:<secret>

# --- Sakura AI Engine (Anthropic-compatible) + Claude Code ---
# AGENT_PLATFORM_AGENT_RUNTIME=claude-code
# AGENT_PLATFORM_AGENT_BASE_URL=https://api.ai.sakura.ad.jp
# AGENT_PLATFORM_AGENT_MODEL=gpt-oss-120b
# AGENT_PLATFORM_AGENT_AUTH_SCHEME=bearer
# LLM_API_KEY=<UUID>:<secret>

# --- OpenAI API + Codex CLI ---
# AGENT_PLATFORM_AGENT_RUNTIME=codex
# AGENT_PLATFORM_AGENT_MODEL=gpt-5-codex
# LLM_API_KEY=sk-...

# --- Anthropic API + Claude Code ---
# AGENT_PLATFORM_AGENT_RUNTIME=claude-code
# AGENT_PLATFORM_AGENT_MODEL=claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

# --- GitHub Reader App (plan fetches the issue) ---
# AGENT_PLATFORM_GITHUB_API_URL=https://api.github.com
# AGENT_PLATFORM_GITHUB_APP_ID=
# AGENT_PLATFORM_GITHUB_INSTALLATION_ID=
# AGENT_PLATFORM_GITHUB_PRIVATE_KEY_PATH=/home/<you>/.config/agent-platform/reader.pem
